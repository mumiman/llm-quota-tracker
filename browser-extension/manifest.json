{
  "manifest_version": 3,
  "name": "LLM Quota Tracker Real-Time Auto-Sync",
  "version": "2.0.0",
  "description": "Zero-click real-time quota sync for Claude, ChatGPT/Codex, Kimi.ai, and Antigravity into your local LLM Quota Tracker (localhost:3456).",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LLM Quota Auto-Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
